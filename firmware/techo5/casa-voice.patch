+	"github.com/HuskerMinion/techo5/echod/internal/hardware/touch"
+)
+
+func TestCasaVoiceCacheAndPriority(t *testing.T) {
+	s := scene{showDash: true, phase: "thinking", call: phone.State{Phase: phone.Idle}, dash: dashboard.View{Ready: true, Version: 1}}
+	key := casaVoiceFrameKey(s)
+	if key == "" {
+		t.Fatal("voice cannot be cached")
+	}
+	s.dash.Version++
+	if casaVoiceFrameKey(s) == key {
+		t.Fatal("new dashboard frame was ignored")
+	}
+	for _, alter := range []func(*scene){
+		func(s *scene) { s.updateActive = true }, func(s *scene) { s.setupAsking = true }, func(s *scene) { s.showVideo = true }, func(s *scene) { s.showNotification = true }, func(s *scene) { s.showAnnouncement = true }, func(s *scene) { s.showReminder = true }, func(s *scene) { s.showCamera = true }, func(s *scene) { s.showVolume = true }, func(s *scene) { s.call.Phase = phone.Ringing },
+	} {
+		copy := s
+		alter(&copy)
+		if casaVoiceFrameKey(copy) != "" {
+			t.Fatal("a priority page was cached as a voice frame")
+		}
+	}
+}
+
+func TestCasaVoiceLayoutScrollingAndCache(t *testing.T) {
+	canvas := image.NewRGBA(image.Rect(0, 0, 1280, 800))
+	r := newRenderer(canvas)
+	background := image.NewUniform(color.RGBA{220, 200, 180, 255})
+	var photo image.Image = background
+	if path := os.Getenv("CASA_VOICE_BACKGROUND"); path != "" {
+		f, err := os.Open(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		photo, err = png.Decode(f)
+		f.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	examples := []scene{
+		{phase: "listening"},
+		{phase: "thinking", heard: "¿Qué modo tiene la casa?"},
+		{phase: "replying", heard: "¿Qué modo tiene la casa?", reply: "La casa está en modo Tarde. Las luces del salón están encendidas con una luz cálida."},
+		{phase: "replying", heard: "Busca las noticias de hoy y resúmelas.", reply: strings.Repeat("Un resumen de ejemplo para comprobar que puedes leer una respuesta larga deslizando con el dedo. ", 12)},
+		{phase: "lingering", heard: "¿Qué tiempo hará mañana?"},
+	}
+	for i, s := range examples {
+		draw.Draw(canvas, canvas.Rect, photo, image.Point{}, draw.Src)
+		before := canvas.RGBAAt(120, 300)
+		r.casaVoicePage(s)
+		if canvas.RGBAAt(120, 300) != before {
+			t.Fatal("voice obscures the left column")
+		}
+		if r.casaVoice.close.Dx() != 80 || r.casaVoice.close.Dy() != 80 {
+			t.Fatal("close target is smaller than approved")
+		}
+		if !r.casaVoice.close.In(canvas.Rect) {
+			t.Fatal("close outside screen")
+		}
+		cached := r.casaVoice.image
+		r.casaVoicePage(s)
+		if cached != r.casaVoice.image {
+			t.Fatal("unchanged words re-rendered")
+		}
+		if dir := os.Getenv("CASA_VOICE_OUTPUT"); dir != "" {
+			os.MkdirAll(dir, 0755)
+			f, err := os.Create(filepath.Join(dir, []string{"listening.png", "thinking.png", "replying.png", "long-answer.png", "error.png"}[i]))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := png.Encode(f, canvas); err != nil {
+				t.Fatal(err)
+			}
+			f.Close()
+		}
+		if i == 3 {
+			d := &Display{r: r, poke: make(chan struct{}, 1), casaVoiceShowing: true, view: voice.State{Phase: "idle"}}
+			if !d.casaVoiceGesture(touch.Gesture{Kind: touch.Hold, X: 600, Y: 600}) {
+				t.Fatal("voice touch leaked to dashboard")
+			}
+			d.casaVoiceGesture(touch.Gesture{Kind: touch.Drag, X: 600, Y: 300})
+			if d.casaVoiceScroll == 0 {
+				t.Fatal("long response cannot scroll")
+			}
+			d.casaVoiceGesture(touch.Gesture{Kind: touch.Tap, X: r.casaVoice.close.Min.X + 40, Y: r.casaVoice.close.Min.Y + 40})
+			if !d.quiet {
+				t.Fatal("close did not dismiss the response")
+			}
+		}
+	}
+}
+
+func TestCasaVoiceWorksFromClockWithoutOpeningDashboard(t *testing.T) {
+	config.Use(filepath.Join(t.TempDir(), "state.json"))
+	if err := config.Set().Dashboard().Mode(config.DashboardStreamed); err != nil {
+		t.Fatal(err)
+	}
+	for _, phase := range []string{"listening", "thinking", "replying", "lingering"} {
+		for _, night := range []bool{false, true} {
+			d := &Display{}
+			s := scene{phase: phase, redClock: night}
+			d.dashScene(&s, false)
+			if !s.showDash || !d.casaVoiceShowing {
+				t.Fatalf("phase %s night %v falls back to old voice screen", phase, night)
+			}
+			s = scene{phase: phase}
+			d.dashScene(&s, true)
+			if s.showDash {
+				t.Fatal("voice covered a priority page")
+			}
+		}
+	}
+	d := &Display{}
+	idle := scene{phase: "idle"}
+	d.dashScene(&idle, false)
+	if idle.showDash {
+		t.Fatal("voice changed the idle clock setting")
+	}
+}
