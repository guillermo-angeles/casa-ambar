new file mode 100644
index 0000000..8270cd3
--- /dev/null
+++ b/echod/internal/feature/display/casa_voice.go
@@ -0,0 +1,210 @@
+//go:build !dot && !spot
+
+package display
+
+import (
+	"fmt"
+	"image"
+	"image/color"
+	"image/draw"
+	"strings"
+	"unicode/utf8"
+
+	"golang.org/x/image/font"
+
+	"github.com/HuskerMinion/techo5/echod/internal/feature/phone"
+	"github.com/HuskerMinion/techo5/echod/internal/feature/voice"
+	"github.com/HuskerMinion/techo5/echod/internal/hardware/touch"
+)
+
+type casaVoiceLayer struct {
+	key       string
+	image     *image.RGBA
+	faces     [5]font.Face
+	close     image.Rectangle
+	maxScroll int
+}
+
+func casaVoicePhase(phase string) bool {
+	return phase == "listening" || phase == "thinking" || phase == "replying" || phase == "lingering"
+}
+
+func casaVoiceFrameKey(s scene) string {
+	if !s.showDash || !casaVoicePhase(s.phase) || s.updateActive || s.call.Phase != phone.Idle || s.ring.any() || s.showVolume || s.showSheet || s.showDrawer || s.showCamera || s.showWeather || s.showRadar || s.showAlert || s.showCalendar || s.showDeck || s.showWifi || s.bt.Pairing || s.setupAsking || s.showVideo || s.showVideoAsk || s.showAnnouncement || s.announceRecording || s.showReminder || s.showNotification || s.popup != nil || s.pin.open {
+		return ""
+	}
+	return fmt.Sprintf("%d:%t:%s:%s:%s:%s:%d", s.dash.Version, s.dash.Ready, s.dash.Problem, s.phase, s.heard, s.reply, s.casaVoiceScroll) + fmt.Sprint(s.muted)
+}
+
+func (r *renderer) casaPx(n int) int { return n * r.w / 1280 }
+
+func (r *renderer) casaVoicePage(s scene) {
+	key := fmt.Sprintf("%s\x00%s\x00%s\x00%d", s.phase, s.heard, s.reply, s.casaVoiceScroll)
+	if r.casaVoice.image == nil || r.casaVoice.key != key {
+		r.casaVoice.image = image.NewRGBA(r.dst.Rect)
+		if r.casaVoice.faces[0] == nil {
+			for i, size := range []int{20, 19, 25, 30, 38} {
+				r.casaVoice.faces[i] = fontFace("inter", i == 0, float64(r.casaPx(size))/0.95)
+			}
+		}
+		previous := r.dst
+		r.dst = r.casaVoice.image
+		r.drawCasaVoice(s)
+		r.dst = previous
+		r.casaVoice.key = key
+	}
+	draw.Draw(r.dst, r.dst.Rect, r.casaVoice.image, image.Point{}, draw.Over)
+}
+
+func (r *renderer) casaLines(face font.Face, text string, width int) []string {
+	var out []string
+	for _, paragraph := range strings.Split(text, "\n") {
+		for _, line := range r.wrap(face, paragraph, width) {
+			for r.width(face, line) > width && utf8.RuneCountInString(line) > 1 {
+				runes := []rune(line)
+				n := len(runes) - 1
+				for n > 1 && r.width(face, string(runes[:n])) > width {
+					n--
+				}
+				out = append(out, string(runes[:n]))
+				line = string(runes[n:])
+			}
+			out = append(out, line)
+		}
+	}
+	return out
+}
+
+func (r *renderer) drawCasaVoice(s scene) {
+	px := r.casaPx
+	ink := color.RGBA{0x48, 0x36, 0x30, 255}
+	muted := color.RGBA{0x79, 0x62, 0x50, 255}
+	colors := []color.RGBA{{137, 184, 190, 255}, {187, 169, 213, 255}, {217, 144, 173, 255}, {241, 188, 128, 255}, {165, 196, 186, 255}}
+	for y := 0; y < r.h; y++ {
+		for x := 0; x < r.w; x++ {
+			if x >= px(7) && x < r.w-px(7) && y >= px(7) && y < r.h-px(7) {
+				continue
+			}
+			t := (float64(x)/float64(r.w)*0.7 + float64(y)/float64(r.h)*0.3) * 4
+			i := min(int(t), 3)
+			f := t - float64(i)
+			mix := func(a, b uint8) uint8 { return uint8(float64(a)*(1-f) + float64(b)*f) }
+			a, b := colors[i], colors[i+1]
+			r.dst.SetRGBA(x, y, color.RGBA{mix(a.R, b.R), mix(a.G, b.G), mix(a.B, b.B), 255})
+		}
+	}
+	phase := "Te escucho"
+	question := s.heard
+	answer := s.reply
+	if question == "" {
+		question = "¿Qué necesitas?"
+	}
+	switch s.phase {
+	case "thinking":
+		phase = "Preparando respuesta"
+		answer = "Estoy preparando la respuesta."
+	case "replying":
+		phase = "Respondiendo"
+	case "lingering":
+		phase = "Casa"
+		if answer == "" {
+			answer = "No he recibido la respuesta. Puedes volver a intentarlo."
+		}
+	}
+	questionFace := r.casaVoice.faces[2]
+	if s.phase == "listening" {
+		questionFace = r.casaVoice.faces[4]
+	}
+	questions := r.casaLines(questionFace, question, px(720))
+	if len(questions) > 2 {
+		questions = questions[:2]
+		questions[1] = r.fit(questionFace, questions[1], px(690)) + "…"
+	}
+	answers := r.casaLines(r.casaVoice.faces[3], answer, px(790))
+	lineH := px(43)
+	visible := min(len(answers), 6)
+	questionH := len(questions) * px(36)
+	if s.phase == "listening" {
+		questionH = px(54)
+	}
+	height := max(px(206), px(110)+questionH+visible*lineH)
+	card := image.Rect(r.w-px(920), r.h-px(32)-height, r.w-px(32), r.h-px(32))
+	r.casaRound(card, float64(px(30)), color.RGBA{228, 206, 179, 255})
+	r.casaRound(card.Inset(1), float64(px(30)-1), color.RGBA{255, 249, 239, 255})
+	close := image.Rect(card.Max.X-px(96), card.Min.Y+px(14), card.Max.X-px(16), card.Min.Y+px(94))
+	r.casaRound(close, float64(px(40)), color.RGBA{241, 229, 213, 255})
+	r.text(r.casaVoice.faces[3], "×", close.Min.X+px(29), close.Min.Y+px(52), color.RGBA{121, 81, 90, 255})
+	signal := image.Rect(card.Min.X+px(30), card.Min.Y+px(30), card.Min.X+px(62), card.Min.Y+px(62))
+	r.casaRound(signal, float64(px(16)), colors[2])
+	r.text(r.casaVoice.faces[0], "Casa", card.Min.X+px(76), card.Min.Y+px(54), ink)
+	r.text(r.casaVoice.faces[1], phase, close.Min.X-px(20)-r.width(r.casaVoice.faces[1], phase), card.Min.Y+px(54), muted)
+	y := card.Min.Y + px(111)
+	for _, line := range questions {
+		r.text(questionFace, line, card.Min.X+px(30), y, ink)
+		y += px(36)
+	}
+	y += px(17)
+	maxScroll := max(len(answers)-visible, 0)
+	scroll := min(max(s.casaVoiceScroll, 0), maxScroll)
+	for _, line := range answers[scroll : scroll+visible] {
+		r.text(r.casaVoice.faces[3], line, card.Min.X+px(30), y, ink)
+		y += lineH
+	}
+	r.zmu.Lock()
+	r.casaVoice.close = close
+	r.casaVoice.maxScroll = maxScroll
+	r.zmu.Unlock()
+}
+
+func (d *Display) casaVoiceGesture(g touch.Gesture) bool {
+	d.mu.Lock()
+	up := d.casaVoiceShowing
+	d.mu.Unlock()
+	if !up || d.r == nil {
+		return false
+	}
+	d.r.zmu.Lock()
+	close, maxScroll := d.r.casaVoice.close, d.r.casaVoice.maxScroll
+	d.r.zmu.Unlock()
+	switch g.Kind {
+	case touch.Tap:
+		if image.Pt(g.X, g.Y).In(close) {
+			d.mu.Lock()
+			active := d.view.Phase != "idle"
+			d.mu.Unlock()
+			d.clearAnswer()
+			if active {
+				voice.Get().Action()
+			}
+		}
+	case touch.Hold:
+		d.mu.Lock()
+		d.casaVoiceDragY = g.Y
+		d.casaVoiceStart = d.casaVoiceScroll
+		d.mu.Unlock()
+	case touch.Drag, touch.Release:
+		d.mu.Lock()
+		d.casaVoiceScroll = min(max(d.casaVoiceStart+(d.casaVoiceDragY-g.Y)/max(d.r.casaPx(43), 1), 0), maxScroll)
+		d.mu.Unlock()
+	case touch.SwipeUp:
+		d.mu.Lock()
+		d.casaVoiceScroll = min(d.casaVoiceScroll+1, maxScroll)
+		d.mu.Unlock()
+	case touch.SwipeDown:
+		d.mu.Lock()
+		d.casaVoiceScroll = max(d.casaVoiceScroll-1, 0)
+		d.mu.Unlock()
+	}
+	return true
+}
+
+func (r *renderer) casaRound(b image.Rectangle, radius float64, fill color.RGBA) {
+	mask := image.NewAlpha(b)
+	for y := b.Min.Y; y < b.Max.Y; y++ {
+		for x := b.Min.X; x < b.Max.X; x++ {
+			a := clamp01(0.5 - rrDist(float64(x)+0.5, float64(y)+0.5, float64(b.Min.X), float64(b.Min.Y), float64(b.Max.X), float64(b.Max.Y), radius))
+			mask.SetAlpha(x, y, color.Alpha{uint8(a * 255)})
+		}
+	}
+	draw.DrawMask(r.dst, b, image.NewUniform(fill), image.Point{}, mask, b.Min, draw.Over)
+}
